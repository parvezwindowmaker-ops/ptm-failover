{
  "name": "ptm-failover",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "demo": "node scripts/demo.mjs",
    "build": "vite build --config apps/web/vite.config.ts && node scripts/build.mjs",
    "start": "node dist/server.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "secrets": "node scripts/secrets.mjs",
    "backup": "tsx scripts/backup.ts"
  },
  "dependencies": {
    "@ptm/contracts": "0.1.0",
    "@ptm/providers": "0.1.0",
    "@ptm/routing": "0.1.0",
    "@ptm/orchestrator": "0.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-is": "19.3.0",
    "react-router-dom": "7.18.4",
    "@tanstack/react-query": "5.104.2",
    "react-hook-form": "7.90.0",
    "@hookform/resolvers": "5.9.1",
    "zod": "4.6.7",
    "lucide-react": "1.57.0",
    "recharts": "3.10.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "tailwind-merge": "3.7.0",
    "fastify": "5.12.7",
    "@fastify/cookie": "11.1.3",
    "@fastify/static": "10.1.6",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/swagger": "9.9.2",
    "better-sqlite3": "13.0.3",
    "argon2": "0.45.1",
    "@aws-sdk/client-ec2": "3.1151.0",
    "ipaddr.js": "2.5.0",
    "ssh2": "1.17.0"
  },
  "devDependencies": {
    "@typescript/native": "npm:typescript@7.0.2",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "tsx": "4.23.15",
    "vite": "8.3.4",
    "@vitejs/plugin-react": "6.1.2",
    "tailwindcss": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "esbuild": "0.28.2",
    "vitest": "5.0.4",
    "@playwright/test": "1.64.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/ssh2": "1.15.6",
    "eslint": "10.12.0",
    "@eslint/js": "10.0.1",
    "typescript-eslint": "8.71.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.10"
  }
}
